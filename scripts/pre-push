#!/bin/sh
# Run repository hooks, then check the committed Go sources being pushed.
set -eu
PATH="$HOME/go/bin:/opt/homebrew/bin:/usr/local/go/bin:/usr/local/bin:$PATH"
export PATH
formatter=${GORGEOUS_BIN:-$(command -v gorgeous 2>/dev/null || :)}
[ -n "$formatter" ] || formatter="$HOME/go/bin/gorgeous"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/gorgeous-pre-push.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cat > "$scratch/refs"

common_dir=$(git rev-parse --git-common-dir)
local_hook="$common_dir/hooks/pre-push"
if [ -x "$local_hook" ]; then
    "$local_hook" "$@" < "$scratch/refs" || exit $?
fi

seen=' '
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleted refs have an all-zero object ID.
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac
    # Tags of blobs or trees contain no commit to check.
    commit=$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null) || continue
    case "$seen" in
        *" $commit "*) continue ;;
    esac
    seen="$seen$commit "
    snapshot="$scratch/$commit"
    mkdir "$snapshot"
    git archive --format=tar "$commit" > "$scratch/source.tar"
    tar -xf "$scratch/source.tar" -C "$snapshot"
    go_file=$(find "$snapshot" \( -name vendor -o -name testdata -o -name '.*' \) -prune -o -type f -name '*.go' -print -quit)
    [ -n "$go_file" ] || continue
    if [ ! -x "$formatter" ]; then
        printf '%s\n' "[gorgeous] Missing executable: $formatter" >&2
        exit 1
    fi
    printf '[gorgeous] Checking %s (%s)\n' "$local_ref" "$commit" >&2
    if ! (cd "$snapshot" && GOWORK= "$formatter" -d ./...); then
        printf '%s\n' '[gorgeous] Push blocked. Run gorgeous ./..., commit the changes, then push again.' >&2
        exit 1
    fi
done < "$scratch/refs"
